{
  "name": "@sap/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@gradio/client": "^2.7.0",
    "@sap/config": "0.1.0",
    "bullmq": "^6.3.8",
    "ioredis": "^5.8.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
