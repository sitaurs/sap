# Server-side only; never use NEXT_PUBLIC_ for backend credentials.
# API_INTERNAL_URL is the canonical name (matches the backend config). The proxy
# also accepts the legacy SAPA_API_BASE_URL if API_INTERNAL_URL is unset.
API_INTERNAL_URL=http://localhost:3001
# Match the API's MFA_TOTP_ENABLED flag. Only availability is exposed to the UI;
# MFA_TOTP_ENCRYPTION_KEY belongs exclusively in the backend environment.
MFA_TOTP_ENABLED=false
# SAPA_API_BASE_URL=http://localhost:3001  # legacy alias, optional

# Optional: IP/hostname used by another device on the same network.
# This is a hostname only (without http:// or port).
SAP_ALLOWED_DEV_ORIGINS=192.168.1.20

# Development only: sample volunteer activity data in the browser (production ignores this).
NEXT_PUBLIC_SAP_ACTIVITIES_MOCK=0

# Development only: independent, read-only September 2026 impact examples.
NEXT_PUBLIC_SAP_IMPACT_MOCK=0
