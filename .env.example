# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
CONTRACT_VERSION=1.0.0

# PostgreSQL / Neon. Use pooled URL at runtime; direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Upstash native Redis TLS URL (not REST URL/token)
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Session and CSRF: generate independent random values of at least 32 bytes.
SESSION_SECRET=replace-with-random-secret
CSRF_SECRET=replace-with-different-random-secret

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=SAP <no-reply@example.com>

# Cloudflare R2 (S3-compatible, private bucket)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=sap
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Self-hosted EcoLens Gradio
ML_INFERENCE_URL=https://ml.example.com
ML_API_NAME=/predict_gradio
ML_USERNAME=replace-me
ML_PASSWORD=replace-me
ML_TIMEOUT_MS=90000

# Cold-start budget (ms) for the DB readiness probe; absorbs Neon scale-to-zero wakeups.
DB_HEALTH_TIMEOUT_MS=10000

# SAPA virtual assistant (addendum v1.1). Global kill switch; leave false to hide the
# pet and return 503 on /assistant/chat. When true, the LLM_* trio below is required.
SAPA_FEATURE_ENABLED=false
# OpenAI-compatible provider: POST {BASE_URL}/chat/completions, Bearer {API_KEY}.
SAPA_LLM_BASE_URL=https://llm.example.com/v1
SAPA_LLM_API_KEY=replace-me
SAPA_LLM_MODEL=replace-with-model-name
SAPA_LLM_TIMEOUT_MS=30000
SAPA_LLM_MAX_OUTPUT_TOKENS=500
SAPA_LLM_TEMPERATURE=0.3
# Per-account chat throttle (requests per minute).
SAPA_CHAT_RATE_LIMIT_PER_MINUTE=20

# Frontend-only public map style; never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_MAP_STYLE_URL=https://example.com/map-style.json
