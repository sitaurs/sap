# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
CONTRACT_VERSION=1.1.0

# PostgreSQL / Neon. Use pooled URL at runtime; direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Upstash native Redis TLS URL (not REST URL/token)
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Session and CSRF: generate independent random values of at least 32 bytes.
SESSION_SECRET=replace-with-random-secret
CSRF_SECRET=replace-with-different-random-secret

# Transactional email
MAIL_TRANSPORT=resend
RESEND_API_KEY=re_replace_me
MAIL_FROM=SAP <no-reply@example.com>
# Local development only: set MAIL_TRANSPORT=smtp, remove RESEND_API_KEY,
# and configure SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD privately.
# Production continues to require the Resend transport.

# Cloudflare R2 (S3-compatible, private bucket)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=sap
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Self-hosted EcoLens Gradio
ML_INFERENCE_URL=https://ml.example.com
ML_API_NAME=/predict_gradio
ML_USERNAME=replace-me
ML_PASSWORD=replace-me
ML_TIMEOUT_MS=90000

# Cold-start budget (ms) for the DB readiness probe; absorbs Neon scale-to-zero wakeups.
DB_HEALTH_TIMEOUT_MS=10000

# Optional TOTP MFA. Generate MFA_TOTP_ENCRYPTION_KEY with `openssl rand -hex 32`.
# Keep disabled until the auth contract/UI and operational recovery process are ready.
MFA_TOTP_ENABLED=false
MFA_TOTP_ENCRYPTION_KEY=replace-with-64-hex-character-key

# SAPA virtual assistant (addendum v1.1). Global kill switch; leave false to hide the
# pet and return 503 on /assistant/chat. When true, the LLM_* trio below is required.
SAPA_FEATURE_ENABLED=false
# OpenAI-compatible provider: POST {BASE_URL}/chat/completions, Bearer {API_KEY}.
SAPA_LLM_BASE_URL=https://llm.example.com/v1
SAPA_LLM_API_KEY=replace-me
SAPA_LLM_MODEL=replace-with-model-name
SAPA_LLM_TIMEOUT_MS=30000
SAPA_LLM_MAX_OUTPUT_TOKENS=500
SAPA_LLM_TEMPERATURE=0.3
# Per-account chat throttle (requests per minute).
SAPA_CHAT_RATE_LIMIT_PER_MINUTE=20

# Frontend-only public map style; never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_MAP_STYLE_URL=https://example.com/map-style.json

# R1 backend extension. Apply migrations 0011-0016 together before enabling.
# Published contract stays 1.1.0 until the frontend/contract promotion gate is complete.
SAP_EXTENSION_ENABLED=false
SAP_COMMUNITY_ENABLED=false
SAP_ACTIVITIES_ENABLED=false
SAP_HERMES_ENABLED=false
SAP_INSTAGRAM_ENABLED=false
SAP_INSTAGRAM_RENDER_ENABLED=false
SAP_INSTAGRAM_PUBLISH_ENABLED=false
META_DELETE_ENABLED=false

# Private Hermes transport; provider key exists only in services/hermes-review runtime.
HERMES_REVIEW_URL=
HERMES_REVIEW_SECRET=
HERMES_MODEL_VERSION=unconfigured
HERMES_POLICY_VERSION=sap-moderation-r1
HERMES_TIMEOUT_MS=90000
HERMES_MAX_ITERATIONS=6
HERMES_MAX_INPUT_TOKENS=16000
HERMES_MAX_OUTPUT_TOKENS=2048
HERMES_RUN_BUDGET_USD=0.25
HERMES_DAILY_BUDGET_USD=5

# Poster: operator-approved Overpass HTTPS endpoint. No provider call while render is off.
# A self-hosted/dedicated endpoint is appropriate for sustained production volume.
POSTER_OVERPASS_URL=
POSTER_MAP_CACHE_HOURS=168
POSTER_MAP_DAILY_LIMIT=100

# Meta Facebook Login configuration; never expose credentials in NEXT_PUBLIC_*.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_PAGE_ID=
META_GRAPH_VERSION=
META_REDIRECT_URI=
META_MEDIA_DELIVERY_ORIGIN=
META_CREDENTIAL_KEY=
EXTENSION_JOB_CONCURRENCY=2
EXTENSION_JOB_LEASE_MS=180000
EXTENSION_JOB_MAX_ATTEMPTS=5
